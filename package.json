{
    "name": "react-fun-with-flags",
    "version": "0.2.0",
    "description": "A React library for working with feature flags.",
    "sideEffects": false,
    "engines": {
        "node": ">=20"
    },
    "type": "module",
    "main": "dist/index.js",
    "module": "dist/index.es.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "import": "./dist/index.es.js",
            "require": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    },
    "scripts": {
        "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
        "build": "npm run clean && rollup -c rollup.config.mjs",
        "dev": "rollup -c rollup.config.mjs -w",
        "prepare": "husky",
        "playground": "vite --config playground/example/vite.config.ts",
        "playground:build": "vite build --config playground/example/vite.config.ts",
        "precommit:verify": "npm run lint && npm run test && npm run build",
        "test": "vitest --run",
        "lint": "eslint src --ext ts,tsx",
        "typecheck": "tsc --noEmit",
        "type-test": "npm run build && tsd",
        "pack:check": "npm run build && npm pack --dry-run",
        "changeset": "changeset",
        "version-packages": "changeset version",
        "release": "changeset publish",
        "format": "prettier --write src",
        "prepublishOnly": "npm run build && npm run lint && npm run test && npm run typecheck && npm run type-test && npm run pack:check"
    },
    "devDependencies": {
        "@changesets/cli": "^2.29.7",
        "@changesets/changelog-github": "^0.6.0",
        "@rollup/plugin-commonjs": "^29.0.2",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-terser": "^1.0.0",
        "@rollup/plugin-typescript": "^12.3.0",
        "@testing-library/jest-dom": "^6.0.0",
        "@testing-library/react": "^16.3.2",
        "@types/node": "^25.5.0",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@typescript-eslint/eslint-plugin": "^8.57.0",
        "@typescript-eslint/parser": "^8.57.0",
        "@vitejs/plugin-react": "^6.0.1",
        "eslint": "^8.57.1",
        "eslint-plugin-react": "^7.33.0",
        "eslint-plugin-react-hooks": "^7.0.1",
        "husky": "^9.1.7",
        "jsdom": "^29.0.1",
        "prettier": "^3.0.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "rollup": "^4.59.1",
        "tsd": "^0.33.0",
        "tslib": "^2.8.1",
        "typescript": "^5.0.0",
        "vite": "^8.0.1",
        "vitest": "^4.1.0"
    },
    "peerDependencies": {
        "react": ">=19.2.0 <20",
        "react-dom": ">=19.2.0 <20"
    },
    "keywords": [
        "react",
        "feature-flags",
        "feature-toggle",
        "rollout",
        "typescript",
        "react-hooks"
    ],
    "author": "react-fun-with-flags contributors",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/thiago-slb/react-fun-with-flags.git"
    },
    "bugs": {
        "url": "https://github.com/thiago-slb/react-fun-with-flags/issues"
    },
    "homepage": "https://github.com/thiago-slb/react-fun-with-flags#readme",
    "tsd": {
        "directory": "test-d"
    }
}
